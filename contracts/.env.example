# Copy to .env (git-ignored). No private keys here: sign with a Foundry keystore (--account) or --ledger.
MEZO_TESTNET_RPC_URL=https://rpc.test.mezo.org
EXPECTED_CHAIN_ID=31611

# Defaults to the real Mezo testnet tokens (docs/mezo-integration.md). Override only for another network.
# MUSD_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503
# MEZO_ADDRESS=0x7B7c000000000000000000000000000000000001

# Factory bounds (fixed at deployment). Durations in seconds, amounts in wei, ratios in bps.
MIN_BOND=1000000000000000000          # 1 MEZO
MIN_DURATION=600                      # 10 min (testnet; use days on mainnet)
MAX_DURATION=2592000                  # 30 days
MIN_TIMELOCK=300                      # 5 min (testnet)
MAX_TIMELOCK=1209600                  # 14 days
MIN_SOFTCAP_BPS=2000                  # soft cap >= 20% of hard cap
MAX_FIRST_TRANCHE_BPS=5000            # team gets at most 50% at finalize
MIN_VETO_BPS=500                      # veto threshold between 5% ...
MAX_VETO_BPS=5000                     # ... and 50% of raised

# Tier vault. Caps are in MUSD wei; CAP_PER_MEZO is extra cap per 1e18 MEZO staked.
VAULT_OWNER=0x0000000000000000000000000000000000000000   # can only retune the cap curve
ABSOLUTE_MAX_CAP=10000000000000000000000                  # 10,000 MUSD, owner can never exceed this
BASE_CAP=500000000000000000000                            # 500 MUSD with no stake
CAP_PER_MEZO=100000000000000000000                        # +100 MUSD per staked MEZO
MAX_CAP=5000000000000000000000                            # 5,000 MUSD per wallet
